# matugen writes this from colors.conf.template at runtime; it hardcodes the
# current machine's absolute wallpaper path, so it must not be committed.
/src/config/colors.conf

.claude/

# Staged by the test harnesses (Quickshell requires the entry point to sit
# beside the modules it imports, so each one is copied to the repo root for the
# duration of its run and removed afterwards).
/.service-tier-test.qml
/.compositor-facade-test.qml
/.plugin-host-test.qml
/.agent-settings-legacy-test.qml
/.updates-page-test.qml
# Written by the image build beside the installed shell; staged by
# tests/run-updates-page-test.sh for the length of its run.
/.rime-shell-commit
